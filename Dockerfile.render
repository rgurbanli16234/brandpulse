# syntax=docker/dockerfile:1
# BrandPulse — lean single-container image for 512 MB hosts (Render free tier).
#
# Identical to ./Dockerfile except it does NOT install torch/transformers or bake the
# neural sentiment model: on a 512 MB instance the model cannot be loaded, so the rule
# analyzer is used (ANALYZER=rules in render.yaml). The build is therefore small and
# fast instead of downloading ~3 GB it can never use.
#
#   docker build -f Dockerfile.render -t brandpulse-lean .
#   docker run -p 7860:7860 brandpulse-lean

# ---------------------------------------------------------------------------
# Stage 1 — build the frontend into a static SPA (index.html + /assets)
# ---------------------------------------------------------------------------
FROM node:22-slim AS frontend

WORKDIR /fe

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# NITRO_PRESET is deliberately NOT set: TanStack Start's prerender step needs the
# default cloudflare-module preset to emit a static .output/public/index.html.
ENV NODE_ENV=production
RUN npm run build


# ---------------------------------------------------------------------------
# Stage 2 — FastAPI + uvicorn serving the API and the built SPA
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ENVIRONMENT=production \
    FRONTEND_DIR=/app/frontend_dist \
    DATABASE_URL=sqlite:////app/data/brandpulse.db \
    ANALYZER=rules \
    AUTO_SEED=true \
    ENABLE_SCHEDULER=true \
    CORS_ORIGIN_REGEX= \
    PORT=7860

RUN useradd -m -u 1000 user

WORKDIR /app

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app

COPY --from=frontend /fe/.output/public ./frontend_dist

RUN mkdir -p /app/data && chown -R user:user /app

USER user

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:' + __import__('os').environ.get('PORT','7860') + '/health')" || exit 1

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-7860}"]
