# BrandPulse — copy to .env and adjust as needed. All values are optional for local dev.

# --- Database (SQLite by default; point to Postgres to switch) ---
DATABASE_URL=sqlite:///./brandpulse.db

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://localhost:3000
# Dev: accept any localhost / 127.0.0.1 origin on any port. Leave empty in production.
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# --- Analyzer: "rules" (default, no downloads) or "hf" (optional model) ---
ANALYZER=rules
HF_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

# --- Pipeline / clustering / scoring ---
PIPELINE_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=true
CLUSTERING_THRESHOLD=0.62
CLUSTERING_WINDOW_HOURS=48
SPIKE_MULTIPLIER=2.0
ALERT_COOLDOWN_MINUTES=60

# --- Alert delivery (optional; in-app alerts always work) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional LLM summary for alerts (template summary used when empty) ---
LLM_API_KEY=
